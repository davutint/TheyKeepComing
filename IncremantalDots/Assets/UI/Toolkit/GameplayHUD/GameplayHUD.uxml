<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Toolkit/Shared/DeadWallsTheme.uss" />
    <ui:Style src="project://database/Assets/UI/Toolkit/GameplayHUD/GameplayHUD.uss" />

    <ui:VisualElement name="screen" class="dw-screen runtime-shell input--pointer phase--day">
        <ui:VisualElement name="worldTint" class="world-tint" picking-mode="Ignore" />
        <ui:VisualElement name="damageFlash" class="damage-flash" picking-mode="Ignore" />

        <ui:VisualElement name="hudLayer" class="hud-layer">
            <ui:VisualElement class="economy-cluster">
                <ui:VisualElement class="cluster-heading">
                    <ui:Label text="THE KEEP" class="cluster-kicker" />
                    <ui:Label name="economyBalance" text="STABLE" class="cluster-state" />
                </ui:VisualElement>
                <ui:VisualElement class="resource-grid">
                    <ui:VisualElement class="resource-readout resource--wood">
                        <ui:VisualElement class="dw-icon dw-icon--resource dw-icon--wood" picking-mode="Ignore" />
                        <ui:Label text="WOOD" class="readout-label" />
                        <ui:VisualElement class="readout-number-stack">
                            <ui:Label name="woodValue" text="0" class="readout-value" />
                            <ui:Label name="woodRate" text="0/m" class="readout-rate" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="resource-readout resource--stone">
                        <ui:VisualElement class="dw-icon dw-icon--resource dw-icon--stone" picking-mode="Ignore" />
                        <ui:Label text="STONE" class="readout-label" />
                        <ui:VisualElement class="readout-number-stack">
                            <ui:Label name="stoneValue" text="0" class="readout-value" />
                            <ui:Label name="stoneRate" text="0/m" class="readout-rate" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="resource-readout resource--iron">
                        <ui:VisualElement class="dw-icon dw-icon--resource dw-icon--iron" picking-mode="Ignore" />
                        <ui:Label text="IRON" class="readout-label" />
                        <ui:VisualElement class="readout-number-stack">
                            <ui:Label name="ironValue" text="0" class="readout-value" />
                            <ui:Label name="ironRate" text="0/m" class="readout-rate" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="resource-readout resource--food">
                        <ui:VisualElement class="dw-icon dw-icon--resource dw-icon--food" picking-mode="Ignore" />
                        <ui:Label text="FOOD" class="readout-label" />
                        <ui:VisualElement class="readout-number-stack">
                            <ui:Label name="foodValue" text="0" class="readout-value" />
                            <ui:Label name="foodRate" text="0/m" class="readout-rate" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="population-line">
                    <ui:VisualElement class="population-copy">
                        <ui:VisualElement class="dw-icon dw-icon--micro dw-icon--population" picking-mode="Ignore" />
                        <ui:Label name="populationValue" text="0 / 0 PEOPLE" class="population-main" />
                    </ui:VisualElement>
                    <ui:Label name="populationDetail" text="0 IDLE" class="population-detail" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="siege-clock">
                <ui:VisualElement class="clock-day-copy">
                    <ui:Label name="dayValue" text="DAY 1" class="clock-day" />
                    <ui:Label name="cycleMessage" text="BUILD WHILE THE LIGHT HOLDS" class="clock-message" />
                </ui:VisualElement>
                <ui:VisualElement name="cycleOrbit" class="cycle-orbit" picking-mode="Ignore">
                    <ui:VisualElement name="cycleArc" class="cycle-arc">
                        <ui:VisualElement class="cycle-horizon" />
                        <ui:VisualElement class="cycle-arc-line" />
                        <ui:VisualElement name="cycleCelestial" class="cycle-celestial">
                            <ui:VisualElement class="cycle-celestial-glow" />
                            <ui:VisualElement name="cycleCelestialMarker" class="dw-icon cycle-celestial-marker dw-icon--day" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="phase-segments">
                        <ui:VisualElement name="phaseDay" class="phase-segment phase-segment--day is-active">
                            <ui:VisualElement name="phaseDayFill" class="phase-segment-fill" />
                            <ui:VisualElement class="dw-icon dw-icon--phase-stop dw-icon--day" />
                        </ui:VisualElement>
                        <ui:VisualElement name="phaseDusk" class="phase-segment phase-segment--dusk">
                            <ui:VisualElement name="phaseDuskFill" class="phase-segment-fill" />
                            <ui:VisualElement class="dw-icon dw-icon--phase-stop dw-icon--dusk" />
                        </ui:VisualElement>
                        <ui:VisualElement name="phaseNight" class="phase-segment phase-segment--night">
                            <ui:VisualElement name="phaseNightFill" class="phase-segment-fill" />
                            <ui:VisualElement class="dw-icon dw-icon--phase-stop dw-icon--night" />
                        </ui:VisualElement>
                        <ui:VisualElement name="phaseDawn" class="phase-segment phase-segment--dawn">
                            <ui:VisualElement name="phaseDawnFill" class="phase-segment-fill" />
                            <ui:VisualElement class="dw-icon dw-icon--phase-stop dw-icon--dawn" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="clock-phase-copy">
                    <ui:Label name="phaseValue" text="DAYLIGHT" class="clock-phase" />
                    <ui:Label name="phaseCountdown" text="02:00" class="clock-time" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="threat-cluster">
                <ui:VisualElement class="threat-line">
                    <ui:VisualElement class="threat-metric">
                        <ui:VisualElement class="dw-icon dw-icon--metric dw-icon--wall" picking-mode="Ignore" />
                        <ui:VisualElement>
                        <ui:Label text="WALL INTEGRITY" class="readout-label" />
                        <ui:Label name="wallValue" text="100%" class="wall-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="hostile-readout">
                        <ui:VisualElement class="dw-icon dw-icon--metric dw-icon--hostiles" picking-mode="Ignore" />
                        <ui:VisualElement class="hostile-copy"><ui:Label text="HOSTILES" class="readout-label" /><ui:Label name="hostilesValue" text="0" class="hostile-value" /></ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="defensePanel" class="wall-track">
                    <ui:VisualElement name="wallProgress" class="wall-progress" />
                </ui:VisualElement>
                <ui:VisualElement class="supply-line">
                    <ui:VisualElement class="supply-copy"><ui:VisualElement class="dw-icon dw-icon--micro dw-icon--arrows" picking-mode="Ignore" /><ui:Label name="arrowValue" text="0 / 0 ARROWS" class="supply-value" /></ui:VisualElement>
                    <ui:Label name="arrowDetail" text="SUPPLY READY" class="supply-state" />
                </ui:VisualElement>
                <ui:VisualElement name="soulAnchor" class="soul-readout">
                    <ui:VisualElement class="dw-icon dw-icon--micro dw-icon--souls" picking-mode="Ignore" />
                    <ui:Label name="soulValue" text="0" class="soul-value" />
                    <ui:Label text="SOULS" class="soul-label" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="ability-dock">
                <ui:Button name="fireballButton" class="ability-command">
                    <ui:VisualElement name="fireballCooldown" class="ability-cooldown" picking-mode="Ignore" />
                    <ui:Label text="1" class="ability-prompt" picking-mode="Ignore" />
                    <ui:VisualElement class="dw-icon dw-icon--ability dw-icon--fireball" picking-mode="Ignore" />
                    <ui:VisualElement class="ability-copy" picking-mode="Ignore">
                        <ui:Label text="FIREBALL" class="ability-name" />
                        <ui:Label name="fireballState" text="LOCKED" class="ability-state" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="rallyButton" class="ability-command">
                    <ui:VisualElement name="rallyCooldown" class="ability-cooldown" picking-mode="Ignore" />
                    <ui:Label text="2" class="ability-prompt" picking-mode="Ignore" />
                    <ui:VisualElement class="dw-icon dw-icon--ability dw-icon--rally" picking-mode="Ignore" />
                    <ui:VisualElement class="ability-copy" picking-mode="Ignore">
                        <ui:Label text="RALLY" class="ability-name" />
                        <ui:Label name="rallyState" text="READY" class="ability-state" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="repairButton" class="ability-command">
                    <ui:VisualElement name="repairCooldown" class="ability-cooldown" picking-mode="Ignore" />
                    <ui:Label text="3" class="ability-prompt" picking-mode="Ignore" />
                    <ui:VisualElement class="dw-icon dw-icon--ability dw-icon--repair" picking-mode="Ignore" />
                    <ui:VisualElement class="ability-copy" picking-mode="Ignore">
                        <ui:Label text="EMERGENCY REPAIR" class="ability-name" />
                        <ui:Label name="repairState" text="NIGHT ONLY" class="ability-state" />
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>

            <ui:VisualElement class="command-rail">
                <ui:Button name="economyButton" class="command-button command-button--economy"><ui:VisualElement class="dw-icon dw-icon--command dw-icon--economy" picking-mode="Ignore" /><ui:Label text="ECONOMY" class="command-label" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="barracksButton" class="command-button"><ui:VisualElement class="dw-icon dw-icon--command dw-icon--barracks" picking-mode="Ignore" /><ui:Label text="BARRACKS" class="command-label" picking-mode="Ignore" /></ui:Button>
                <ui:VisualElement class="command-spacer" />
                <ui:Button name="arrowsButton" class="command-button"><ui:VisualElement class="dw-icon dw-icon--command dw-icon--arrows" picking-mode="Ignore" /><ui:Label text="ARROW SUPPLY" class="command-label" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="heartButton" text="CASTLE HEART" class="command-button command-button--heart" />
                <ui:Button name="pauseButton" class="command-button command-button--pause"><ui:VisualElement class="dw-icon dw-icon--command dw-icon--pause" picking-mode="Ignore" /></ui:Button>
            </ui:VisualElement>

            <ui:VisualElement name="criticalBanner" class="critical-banner">
                <ui:Label name="criticalBannerTitle" text="THE WALL IS FAILING" class="critical-title" />
                <ui:Label name="criticalBannerBody" text="Repair before the next breach." class="critical-body" />
            </ui:VisualElement>
            <ui:VisualElement name="onboardingHint" class="onboarding-hint">
                <ui:VisualElement class="hint-marker" />
                <ui:Label name="onboardingHintText" text="ASSIGN IDLE PEOPLE TO A RESOURCE." class="hint-text" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="economyDrawer" class="surface drawer drawer--left economy-drawer">
            <ui:VisualElement class="surface-texture surface-texture--short" picking-mode="Ignore" />
            <ui:VisualElement class="surface-header">
                <ui:VisualElement>
                    <ui:Label text="KEEP ECONOMY" class="surface-title" />
                    <ui:Label text="Balance labour without leaving the battlefield." class="surface-subtitle" />
                </ui:VisualElement>
                <ui:Button name="economyClose" text="CLOSE" class="surface-close" />
            </ui:VisualElement>
            <ui:VisualElement class="economy-summary">
                <ui:VisualElement class="summary-block"><ui:VisualElement class="dw-icon dw-icon--summary dw-icon--population" picking-mode="Ignore" /><ui:VisualElement><ui:Label text="AVAILABLE" class="summary-label" /><ui:Label name="economyIdle" text="0" class="summary-value" /></ui:VisualElement></ui:VisualElement>
                <ui:VisualElement class="summary-block"><ui:VisualElement class="dw-icon dw-icon--summary dw-icon--workers" picking-mode="Ignore" /><ui:VisualElement><ui:Label text="WORKERS" class="summary-label" /><ui:Label name="economyWorkers" text="0" class="summary-value" /></ui:VisualElement></ui:VisualElement>
                <ui:VisualElement class="summary-block"><ui:VisualElement class="dw-icon dw-icon--summary dw-icon--housing" picking-mode="Ignore" /><ui:VisualElement><ui:Label text="HOUSING" class="summary-label" /><ui:Label name="economyHousing" text="0 / 0" class="summary-value" /></ui:VisualElement></ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView name="economyRows" class="surface-scroll economy-rows" mode="Vertical" />
            <ui:VisualElement class="housing-card">
                <ui:VisualElement class="dw-icon dw-icon--card dw-icon--housing" picking-mode="Ignore" />
                <ui:VisualElement class="housing-copy"><ui:Label text="EXPAND HOUSING" class="card-title" /><ui:Label name="housingCost" text="Cost pending" class="card-detail" /></ui:VisualElement>
                <ui:Button name="housingOne" text="+1" class="compact-action" />
                <ui:Button name="housingTen" text="+10" class="compact-action" />
                <ui:Button name="housingHundred" text="+100" class="compact-action" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="barracksDrawer" class="surface drawer drawer--right barracks-drawer">
            <ui:VisualElement class="surface-texture surface-texture--short" picking-mode="Ignore" />
            <ui:VisualElement class="surface-header">
                <ui:VisualElement><ui:Label text="WALL GARRISON" class="surface-title" /><ui:Label text="Recruit for the fight already in progress." class="surface-subtitle" /></ui:VisualElement>
                <ui:Button name="barracksClose" text="CLOSE" class="surface-close" />
            </ui:VisualElement>
            <ui:VisualElement class="barracks-summary">
                <ui:Label name="archerCapacity" text="0 / 0 ARCHERS" class="summary-value" />
                <ui:Label name="archerSummary" text="No formations deployed" class="card-detail" />
            </ui:VisualElement>
            <ui:ScrollView name="archerRows" class="surface-scroll archer-rows" mode="Vertical" />
        </ui:VisualElement>

        <ui:VisualElement name="arrowsDrawer" class="surface drawer drawer--right arrows-drawer">
            <ui:VisualElement class="surface-texture surface-texture--short" picking-mode="Ignore" />
            <ui:VisualElement class="surface-header">
                <ui:VisualElement class="surface-heading-with-icon"><ui:VisualElement class="dw-icon dw-icon--header dw-icon--arrows" picking-mode="Ignore" /><ui:VisualElement><ui:Label text="ARROW SUPPLY" class="surface-title" /><ui:Label text="Restock now; improve the supply line for later." class="surface-subtitle" /></ui:VisualElement></ui:VisualElement>
                <ui:Button name="arrowsClose" text="CLOSE" class="surface-close" />
            </ui:VisualElement>
            <ui:VisualElement class="supply-hero">
                <ui:VisualElement class="supply-hero-copy"><ui:VisualElement class="dw-icon dw-icon--hero dw-icon--arrows" picking-mode="Ignore" /><ui:VisualElement><ui:Label name="supplyHeroValue" text="0 / 0" class="supply-hero-value" /><ui:Label name="supplyHeroState" text="READY" class="supply-hero-state" /></ui:VisualElement></ui:VisualElement>
                <ui:VisualElement class="supply-hero-track"><ui:VisualElement name="supplyHeroProgress" class="supply-hero-progress" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="purchase-stack">
                <ui:Button name="arrowPackage" class="purchase-card"><ui:VisualElement class="dw-icon dw-icon--card dw-icon--crate" picking-mode="Ignore" /><ui:VisualElement class="card-copy"><ui:Label text="FIELD CRATE" class="card-title" /><ui:Label name="arrowPackageDetail" text="0 arrows" class="card-detail" /><ui:Label name="arrowPackageCost" text="0 WOOD" class="card-cost" /></ui:VisualElement></ui:Button>
                <ui:Button name="arrowLargePackage" class="purchase-card"><ui:VisualElement class="dw-icon dw-icon--card dw-icon--wagon" picking-mode="Ignore" /><ui:VisualElement class="card-copy"><ui:Label text="SUPPLY WAGON" class="card-title" /><ui:Label name="arrowLargeDetail" text="0 arrows" class="card-detail" /><ui:Label name="arrowLargeCost" text="0 WOOD" class="card-cost" /></ui:VisualElement></ui:Button>
                <ui:Button name="arrowBuyMax" class="purchase-card purchase-card--primary"><ui:VisualElement class="dw-icon dw-icon--card dw-icon--fill" picking-mode="Ignore" /><ui:VisualElement class="card-copy"><ui:Label text="FILL RESERVES" class="card-title" /><ui:Label name="arrowMaxDetail" text="Fill remaining capacity" class="card-detail" /><ui:Label name="arrowMaxCost" text="0 WOOD" class="card-cost" /></ui:VisualElement></ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="upgrade-stack">
                <ui:Button name="arrowCapacityUpgrade" class="upgrade-card"><ui:VisualElement class="dw-icon dw-icon--card dw-icon--capacity" picking-mode="Ignore" /><ui:VisualElement class="card-copy"><ui:Label text="CAPACITY" class="card-title" /><ui:Label name="arrowCapacityDetail" text="Level 0" class="card-detail" /><ui:Label name="arrowCapacityCost" text="0" class="card-cost" /></ui:VisualElement></ui:Button>
                <ui:Button name="arrowEfficiencyUpgrade" class="upgrade-card"><ui:VisualElement class="dw-icon dw-icon--card dw-icon--efficiency" picking-mode="Ignore" /><ui:VisualElement class="card-copy"><ui:Label text="EFFICIENCY" class="card-title" /><ui:Label name="arrowEfficiencyDetail" text="Level 0" class="card-detail" /><ui:Label name="arrowEfficiencyCost" text="0" class="card-cost" /></ui:VisualElement></ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="heartScreen" class="surface fullscreen heart-screen">
            <ui:VisualElement class="fullscreen-header">
                <ui:VisualElement><ui:Label text="CASTLE HEART" class="fullscreen-title" /><ui:Label text="Research a path to reveal what follows." class="fullscreen-subtitle" /></ui:VisualElement>
                <ui:VisualElement class="fullscreen-tools">
                    <ui:VisualElement name="heartZoomControls" class="heart-zoom-controls">
                        <ui:Button name="heartZoomOut" text="-" tooltip="Zoom out" class="heart-zoom-button" />
                        <ui:Label name="heartZoomValue" text="100%" class="heart-zoom-value" />
                        <ui:Button name="heartZoomIn" text="+" tooltip="Zoom in" class="heart-zoom-button" />
                        <ui:Button name="heartZoomReset" text="FIT" tooltip="Fit the visible tree" class="heart-zoom-button heart-zoom-reset" />
                    </ui:VisualElement>
                    <ui:VisualElement class="heart-essence"><ui:VisualElement class="dw-icon dw-icon--souls heart-essence-icon" picking-mode="Ignore" /><ui:Label name="graveEssenceValue" text="0 ESSENCE" class="currency-value" /></ui:VisualElement>
                    <ui:Button name="heartClose" text="RETURN TO BATTLE" class="surface-close" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="heartViewport" class="graph-viewport heart-viewport">
                <ui:VisualElement class="heart-vignette" picking-mode="Ignore" />
                <ui:VisualElement name="heartGraphContent" class="graph-content heart-graph" />
            </ui:VisualElement>
            <ui:VisualElement name="heartInspector" class="graph-inspector heart-inspector">
                <ui:VisualElement class="heart-inspector-heading">
                    <ui:VisualElement name="heartInspectorIcon" class="heart-inspector-icon" picking-mode="Ignore" />
                    <ui:VisualElement class="heart-inspector-heading-copy"><ui:Label name="heartInspectorTitle" text="CASTLE HEART" class="inspector-title" /><ui:Label name="heartInspectorMeta" text="ORIGIN" class="inspector-meta" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="heartInspectorBody" text="Select a revealed technology to inspect its effect." class="inspector-body" />
                <ui:VisualElement class="heart-inspector-transaction">
                    <ui:Label name="heartInspectorStatus" text="SELECT A TECHNOLOGY" class="inspector-status" />
                    <ui:Label name="heartInspectorCost" text="" class="inspector-cost" />
                </ui:VisualElement>
                <ui:Button name="heartPurchase" text="RESEARCH" class="inspector-action" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="modalShade" class="modal-shade">
            <ui:VisualElement name="councilModal" class="modal council-modal">
                <ui:VisualElement class="surface-texture surface-texture--modal" picking-mode="Ignore" />
                <ui:Label text="THE COUNCIL DEMANDS AN ANSWER" class="modal-kicker" />
                <ui:Label name="councilTitle" text="A Choice at the Gate" class="modal-title" />
                <ui:Label name="councilBody" text="The situation requires an exact decision." class="modal-body" />
                <ui:VisualElement class="decision-timer"><ui:VisualElement name="councilTimerProgress" class="decision-timer-progress" /><ui:Label name="councilTimerText" text="30s" class="decision-timer-text" /></ui:VisualElement>
                <ui:VisualElement class="decision-options">
                    <ui:Button name="councilOptionA" class="decision-card"><ui:Label text="OPTION A" class="decision-label" /><ui:Label name="councilOptionAText" text="Exact outcome" class="decision-copy" /></ui:Button>
                    <ui:Button name="councilOptionB" class="decision-card"><ui:Label text="OPTION B" class="decision-label" /><ui:Label name="councilOptionBText" text="Exact outcome" class="decision-copy" /></ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="levelUpModal" class="modal levelup-modal">
                <ui:VisualElement class="surface-texture surface-texture--modal" picking-mode="Ignore" />
                <ui:Label text="THE KEEP ENDURES" class="modal-kicker" />
                <ui:Label name="levelUpTitle" text="Choose the next advantage" class="modal-title" />
                <ui:VisualElement name="levelUpCards" class="levelup-cards" />
            </ui:VisualElement>

            <ui:VisualElement name="pauseModal" class="modal pause-modal">
                <ui:VisualElement class="surface-texture surface-texture--modal" picking-mode="Ignore" />
                <ui:Label text="BATTLE PAUSED" class="modal-kicker" />
                <ui:Label text="DEAD WALLS" class="modal-title" />
                <ui:Button name="resumeButton" class="modal-action modal-action--primary modal-action--icon"><ui:VisualElement class="dw-icon dw-icon--modal-action dw-icon--play" picking-mode="Ignore" /><ui:Label text="RESUME" class="modal-action-label" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="settingsButton" class="modal-action modal-action--icon"><ui:VisualElement class="dw-icon dw-icon--modal-action dw-icon--settings" picking-mode="Ignore" /><ui:Label text="SETTINGS" class="modal-action-label" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="mainMenuButton" class="modal-action modal-action--icon"><ui:VisualElement class="dw-icon dw-icon--modal-action dw-icon--housing" picking-mode="Ignore" /><ui:Label text="SAVE &amp; RETURN TO MENU" class="modal-action-label" picking-mode="Ignore" /></ui:Button>
            </ui:VisualElement>

            <ui:VisualElement name="settingsModal" class="modal settings-modal">
                <ui:VisualElement class="surface-texture surface-texture--modal" picking-mode="Ignore" />
                <ui:Label text="SETTINGS" class="modal-title" />
                <ui:VisualElement class="setting-heading"><ui:VisualElement class="dw-icon dw-icon--micro dw-icon--sound" picking-mode="Ignore" /><ui:Label text="SOUND EFFECTS" class="setting-label" /></ui:VisualElement>
                <ui:Slider name="sfxSlider" low-value="0" high-value="1" value="1" class="dw-slider" />
                <ui:VisualElement class="setting-heading"><ui:VisualElement class="dw-icon dw-icon--micro dw-icon--music" picking-mode="Ignore" /><ui:Label text="AMBIENCE" class="setting-label" /></ui:VisualElement>
                <ui:Slider name="ambienceSlider" low-value="0" high-value="1" value="1" class="dw-slider" />
                <ui:Button name="resetTutorialButton" class="modal-action modal-action--icon"><ui:VisualElement class="dw-icon dw-icon--modal-action dw-icon--refresh" picking-mode="Ignore" /><ui:Label name="resetTutorialButtonLabel" text="RESET TUTORIAL" class="modal-action-label" picking-mode="Ignore" /></ui:Button>
                <ui:Label name="resetTutorialStatus" text="" class="setting-status" />
                <ui:Button name="settingsClose" class="modal-action modal-action--primary modal-action--icon"><ui:VisualElement class="dw-icon dw-icon--modal-action dw-icon--back" picking-mode="Ignore" /><ui:Label text="BACK" class="modal-action-label" picking-mode="Ignore" /></ui:Button>
            </ui:VisualElement>

            <ui:VisualElement name="gameOverModal" class="modal gameover-modal">
                <ui:VisualElement class="surface-texture surface-texture--gameover" picking-mode="Ignore" />
                <ui:VisualElement class="gameover-header">
                    <ui:Label text="THE FINAL REPORT" class="modal-kicker modal-kicker--danger" />
                    <ui:Label name="gameOverTitle" text="THE WALL HAS FALLEN" class="modal-title gameover-title" />
                    <ui:Label name="gameOverSubtitle" text="The run ends here. What remains will strengthen the next stand." class="gameover-subtitle" />
                </ui:VisualElement>

                <ui:Label name="gameOverRecordBadge" text="NEW LONGEST STAND" class="gameover-record" />
                <ui:VisualElement class="gameover-run-summary">
                    <ui:VisualElement class="gameover-stat"><ui:VisualElement class="dw-icon dw-icon--stat dw-icon--clock" picking-mode="Ignore" /><ui:Label text="DAY HELD" class="gameover-stat-label" /><ui:Label name="gameOverDay" text="1" class="gameover-stat-value" /></ui:VisualElement>
                    <ui:VisualElement class="gameover-stat"><ui:VisualElement class="dw-icon dw-icon--stat dw-icon--hostiles" picking-mode="Ignore" /><ui:Label text="ENEMIES SLAIN" class="gameover-stat-label" /><ui:Label name="gameOverKills" text="0" class="gameover-stat-value" /></ui:VisualElement>
                    <ui:VisualElement class="gameover-stat"><ui:VisualElement class="dw-icon dw-icon--stat dw-icon--trophy" picking-mode="Ignore" /><ui:Label text="BEST STAND" class="gameover-stat-label" /><ui:Label name="gameOverBest" text="1" class="gameover-stat-value" /></ui:VisualElement>
                    <ui:VisualElement class="gameover-stat gameover-stat--earned"><ui:VisualElement class="dw-icon dw-icon--stat dw-icon--embers" picking-mode="Ignore" /><ui:Label text="LAST EMBERS EARNED" class="gameover-stat-label" /><ui:Label name="gameOverEarned" text="+0" class="gameover-stat-value" /></ui:VisualElement>
                    <ui:VisualElement class="gameover-stat gameover-stat--balance"><ui:VisualElement class="dw-icon dw-icon--stat dw-icon--embers" picking-mode="Ignore" /><ui:Label text="AVAILABLE" class="gameover-stat-label" /><ui:Label name="gameOverBalance" text="0" class="gameover-stat-value" /></ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="meta-shop-header">
                    <ui:VisualElement class="meta-shop-heading-copy">
                        <ui:Label name="metaShopTitle" text="FORTIFY THE NEXT STAND" class="meta-shop-title" />
                        <ui:Label name="metaShopHint" text="Permanent upgrades apply to your next run." class="meta-shop-hint" />
                    </ui:VisualElement>
                    <ui:VisualElement class="meta-wallet-wrap"><ui:VisualElement class="dw-icon dw-icon--micro dw-icon--embers" picking-mode="Ignore" /><ui:Label name="metaWallet" text="0 EMBERS" class="meta-wallet" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:ScrollView name="metaShopRows" class="meta-shop" mode="Vertical" />
                <ui:Button name="restartButton" text="BEGIN NEXT RUN" class="modal-action modal-action--primary gameover-restart" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="toastStack" class="toast-stack">
            <ui:Label name="primaryToast" text="" class="toast toast--primary" />
            <ui:Label name="secondaryToast" text="" class="toast toast--secondary" />
        </ui:VisualElement>
        <ui:VisualElement name="soulFlightLayer" class="soul-flight-layer" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
