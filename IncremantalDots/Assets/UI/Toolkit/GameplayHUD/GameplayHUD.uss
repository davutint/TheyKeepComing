.surface-texture {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0.08;
    -unity-background-scale-mode: stretch-to-fill;
}
.surface-texture--short { background-image: url("project://database/Assets/Artsystack - Fantasy RPG GUI/Resources/Sprites/components/bg_layer_short_01.png"); }
.surface-texture--modal { background-image: url("project://database/Assets/Artsystack - Fantasy RPG GUI/Resources/Sprites/components/bg_layer_01.png"); }
.surface-texture--gameover { opacity: 0.11; background-image: url("project://database/Assets/Artsystack - Fantasy RPG GUI/Resources/Sprites/components/bg_layer_02.png"); }

.input--touch .command-rail { height: 64px; bottom: 14px; }
.input--touch .command-button { height: 62px; min-width: 118px; font-size: 11px; }
.input--touch .command-button--pause { min-width: 62px; width: 62px; }
.input--touch .ability-dock { bottom: 92px; height: 84px; }
.input--touch .ability-command { width: 182px; height: 82px; justify-content: center; }
.input--touch #repairButton { width: 206px; }
.input--touch .ability-prompt, .input--gamepad .ability-prompt { display: none; }
.input--touch .ability-copy { flex-grow: 0; min-width: 132px; }
.input--touch .ability-name { font-size: 12px; }.input--touch .ability-state { font-size: 9px; }
.input--touch .compact-action, .input--touch .surface-close, .input--touch .tool-button { min-height: 50px; font-size: 11px; }
.input--touch .purchase-card, .input--touch .upgrade-card { min-height: 96px; }
.input--touch .heart-zoom-controls { height: 52px; padding: 3px; }
.input--touch .heart-zoom-button { width: 46px; height: 46px; font-size: 17px; }
.input--touch .heart-zoom-value { width: 54px; font-size: 10px; }
.input--touch .heart-zoom-reset { width: 50px; font-size: 9px; }

.is-compact .economy-cluster { left: 14px; top: 14px; transform-origin: 0 0; scale: 0.88 0.88; }
.is-compact .threat-cluster { right: 14px; top: 14px; transform-origin: 100% 0; scale: 0.88 0.88; }
.is-compact .siege-clock { top: 14px; transform-origin: 50% 0; scale: 0.86 0.86; }
.is-compact .drawer { width: 100%; max-width: 610px; }
.is-compact .heart-screen { padding-left: 18px; padding-right: 18px; padding-bottom: 18px; }
.is-compact .heart-screen .fullscreen-header { height: 72px; }
.is-compact .heart-screen .fullscreen-subtitle { display: none; }
.is-compact .heart-viewport { left: 18px; right: 18px; top: 108px; bottom: 282px; }
.is-compact .heart-inspector { left: 18px; right: 18px; top: auto; bottom: 18px; width: auto; height: 244px; padding: 16px; }
.is-compact .heart-inspector-heading { position: absolute; left: 16px; top: 16px; width: 278px; padding-bottom: 0; border-bottom-width: 0; }
.is-compact .heart-inspector-icon { width: 54px; height: 54px; margin-right: 12px; }
.is-compact .heart-inspector .inspector-title { font-size: 14px; }
.is-compact .heart-inspector .inspector-meta { margin-top: 5px; }
.is-compact .heart-inspector .inspector-body { position: absolute; left: 316px; right: 232px; top: 17px; max-height: 112px; margin: 0; overflow: hidden; }
.is-compact .heart-inspector-transaction { left: 316px; right: 232px; bottom: 18px; padding-top: 10px; }
.is-compact .heart-inspector .inspector-action { left: auto; right: 16px; bottom: 16px; width: 198px; min-height: 52px; }
.is-short .heart-viewport { top: 96px; bottom: 230px; }
.is-short .heart-inspector { height: 194px; }
.is-short .heart-inspector .inspector-body { max-height: 76px; }
.is-compact .gameover-modal { width: 96%; padding: 18px 20px 16px 20px; }
.is-compact .gameover-title { font-size: 25px; }
.is-compact .gameover-stat { min-width: 108px; padding: 11px 12px; }
.is-compact .gameover-stat-value { font-size: 18px; }
.is-compact .meta-upgrade-transaction { width: 150px; }
.is-short .gameover-modal { height: 96%; max-height: 96%; padding-top: 14px; padding-bottom: 12px; }
.is-short .gameover-title { margin-top: 4px; font-size: 22px; }
.is-short .gameover-subtitle { margin-top: 5px; }
.is-short .gameover-run-summary { min-height: 66px; margin-top: 10px; }
.is-short .gameover-stat { padding-top: 8px; padding-bottom: 8px; }
.is-short .gameover-stat-value { margin-top: 3px; font-size: 17px; }
.is-short .meta-shop-header { min-height: 46px; margin-top: 10px; }
.is-short .meta-shop { min-height: 100px; max-height: none; }
.is-short .meta-shop-row { min-height: 62px; padding-top: 7px; padding-bottom: 7px; }
.is-short .gameover-restart { min-height: 42px; }
