.menu-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
    background-color: rgb(16, 18, 15);
}

.menu-background {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 3.2s;
    transition-timing-function: ease-in-out;
}

.menu-background--day {
    background-image: url("project://database/Assets/UI/Toolkit/MainMenu/MainMenuBackgroundDay.png");
}

.menu-background--dusk {
    background-image: url("project://database/Assets/UI/Toolkit/MainMenu/MainMenuBackground.png");
}

.menu-background--night {
    background-image: url("project://database/Assets/UI/Toolkit/MainMenu/MainMenuBackgroundNight.png");
}

.menu-background--dawn {
    background-image: url("project://database/Assets/UI/Toolkit/MainMenu/MainMenuBackgroundDawn.png");
}

.cycle--day .menu-background--day,
.cycle--dusk .menu-background--dusk,
.cycle--night .menu-background--night,
.cycle--dawn .menu-background--dawn {
    opacity: 1;
}

.menu-vignette {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 8%;
    background-color: rgba(0, 0, 0, 0.08);
}

.menu-vignette--left {
    left: 0;
}

.menu-vignette--right {
    right: 0;
}

.menu-top-rule {
    position: absolute;
    left: 3.2%;
    right: 3.2%;
    top: 44px;
    height: 1px;
    background-color: rgba(225, 224, 210, 0.15);
}

.menu-header {
    position: absolute;
    left: 0;
    right: 0;
    top: 108px;
    align-items: center;
}

.menu-title {
    margin: 0;
    padding: 0;
    color: rgb(239, 237, 228);
    font-size: 54px;
    letter-spacing: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.menu-panel {
    position: absolute;
    left: 50%;
    top: 344px;
    width: 420px;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    translate: -50% 0;
}

.menu-actions {
    width: 100%;
    align-items: center;
}

.menu-primary-row {
    width: 100%;
    height: 54px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.menu-button {
    width: 292px;
    height: 52px;
    min-height: 0;
    margin: 0;
    padding: 0 18px;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(223, 220, 209, 0.56);
    font-size: 15px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.menu-button--primary {
    border-width: 1px;
    border-color: rgba(210, 208, 197, 0.42);
    background-color: rgba(8, 9, 7, 0.84);
    color: rgb(240, 237, 226);
}

.menu-button--primary:hover,
.menu-button--primary:focus {
    border-color: rgba(239, 236, 224, 0.86);
    background-color: rgba(11, 12, 10, 0.96);
    color: white;
}

.menu-button--primary:active {
    border-color: rgb(185, 88, 51);
    background-color: rgb(16, 17, 14);
}

.menu-button--quiet {
    height: 48px;
    margin-top: 14px;
    border-width: 0 0 1px 0;
    border-color: rgba(220, 217, 204, 0);
    background-color: rgba(0, 0, 0, 0);
}

.menu-button--quiet:hover,
.menu-button--quiet:focus {
    border-color: rgba(220, 217, 204, 0.24);
    background-color: rgba(255, 255, 255, 0.012);
    color: rgb(233, 230, 219);
}

.menu-button--quiet:active {
    color: rgb(185, 88, 51);
}

.settings-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
}

.settings-overlay.is-open {
    display: flex;
}

.settings-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(5, 6, 5, 0.84);
}

.settings-modal {
    width: 500px;
    max-width: 86%;
    padding: 40px 44px 36px 44px;
    background-color: rgb(17, 18, 15);
    border-width: 1px;
    border-color: rgba(224, 220, 207, 0.22);
}

.settings-heading {
    margin-bottom: 38px;
}

.settings-title {
    margin: 0;
    padding: 0;
    color: rgb(235, 232, 222);
    font-size: 28px;
    letter-spacing: 4px;
    -unity-font-style: bold;
}

.settings-title-mark {
    width: 28px;
    height: 2px;
    margin-top: 16px;
    background-color: rgb(184, 88, 53);
}

.settings-field {
    margin-bottom: 21px;
}

.settings-field__heading {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.settings-field__identity,
.settings-button-with-icon {
    flex-direction: row;
    align-items: center;
}

.settings-button-with-icon {
    justify-content: center;
}

.settings-text-button.settings-button-with-icon {
    justify-content: flex-start;
}

.settings-button-label {
    margin: 0;
    padding: 0;
    color: rgb(235, 232, 222);
    font-size: inherit;
    letter-spacing: inherit;
    -unity-font-style: bold;
}

.menu-setting-icon {
    width: 18px;
    height: 18px;
    margin-right: 9px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.menu-setting-icon--sound { background-image: url("project://database/Assets/Artsystack - Fantasy RPG GUI/Resources/Sprites/flaticon/textured/128/sound_128_T.png"); }
.menu-setting-icon--music { background-image: url("project://database/Assets/Artsystack - Fantasy RPG GUI/Resources/Sprites/flaticon/textured/128/music_128_T.png"); }
.menu-setting-icon--refresh { background-image: url("project://database/Assets/Artsystack - Fantasy RPG GUI/Resources/Sprites/flaticon/textured/128/refresh_128_T.png"); }
.menu-setting-icon--back { background-image: url("project://database/Assets/Artsystack - Fantasy RPG GUI/Resources/Sprites/flaticon/textured/128/arrow_back_128_T.png"); }

.settings-field__label,
.settings-field__value {
    color: rgba(221, 219, 208, 0.58);
    font-size: 10px;
    letter-spacing: 1.5px;
    -unity-font-style: bold;
}

.settings-field__value {
    color: rgba(239, 236, 225, 0.88);
}

.settings-modal .dw-slider .unity-base-slider__tracker {
    background-color: rgba(225, 222, 210, 0.17);
}

.settings-modal .dw-slider .unity-base-slider__dragger {
    border-color: rgb(36, 38, 33);
    background-color: rgb(213, 209, 196);
}

.settings-modal .dw-slider:focus .unity-base-slider__dragger {
    border-color: rgb(184, 88, 53);
    background-color: rgb(239, 235, 222);
}

.settings-separator {
    height: 1px;
    margin: 10px 0 18px 0;
    background-color: rgba(224, 220, 207, 0.11);
}

.settings-text-button {
    height: 42px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(221, 217, 204, 0.52);
    font-size: 10px;
    letter-spacing: 1.3px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.settings-text-button:hover,
.settings-text-button:focus {
    color: rgb(239, 235, 223);
}

.settings-text-button--danger:hover,
.settings-text-button--danger:focus {
    color: rgb(208, 132, 111);
}

.settings-tutorial-status {
    margin: 3px 0 27px 0;
    color: rgba(212, 209, 197, 0.30);
    font-size: 8px;
    letter-spacing: 0.6px;
    white-space: normal;
}

.settings-close {
    width: 100%;
    height: 50px;
    margin: 0;
    border-width: 1px;
    border-color: rgba(220, 217, 204, 0.36);
    border-radius: 0;
    background-color: rgb(10, 11, 9);
    color: rgb(235, 232, 222);
    font-size: 13px;
    letter-spacing: 2.5px;
    -unity-font-style: bold;
}

.settings-close:hover,
.settings-close:focus {
    border-color: rgba(239, 236, 224, 0.82);
    background-color: rgb(15, 16, 13);
}

.input--touch .menu-button--primary {
    width: 330px;
    height: 64px;
    font-size: 17px;
}

.input--touch .menu-button--quiet {
    width: 330px;
    height: 56px;
    font-size: 16px;
}

.input--touch .menu-primary-row {
    height: 66px;
}

.input--touch .settings-text-button {
    height: 54px;
}

.input--touch .settings-close {
    height: 62px;
}

.menu-screen.is-compact .menu-header {
    top: 76px;
}

.menu-screen.is-compact .menu-title {
    font-size: 44px;
    letter-spacing: 8px;
}

.menu-screen.is-compact .menu-panel {
    top: 286px;
}

.menu-screen.is-short .menu-top-rule {
    top: 26px;
}

.menu-screen.is-short .menu-header {
    top: 48px;
}

.menu-screen.is-short .menu-title {
    font-size: 40px;
}

.menu-screen.is-short .menu-panel {
    top: 210px;
}
