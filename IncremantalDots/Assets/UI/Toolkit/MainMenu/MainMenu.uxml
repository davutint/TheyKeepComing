<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Toolkit/Shared/DeadWallsTheme.uss" />
    <ui:Style src="project://database/Assets/UI/Toolkit/MainMenu/MainMenu.uss" />

    <ui:VisualElement name="screen" class="dw-screen menu-screen cycle--day">
        <ui:VisualElement class="menu-background menu-background--day" picking-mode="Ignore" />
        <ui:VisualElement class="menu-background menu-background--dusk" picking-mode="Ignore" />
        <ui:VisualElement class="menu-background menu-background--night" picking-mode="Ignore" />
        <ui:VisualElement class="menu-background menu-background--dawn" picking-mode="Ignore" />
        <ui:VisualElement class="menu-vignette menu-vignette--left" picking-mode="Ignore" />
        <ui:VisualElement class="menu-vignette menu-vignette--right" picking-mode="Ignore" />
        <ui:VisualElement class="menu-top-rule" picking-mode="Ignore" />

        <ui:VisualElement class="menu-header" picking-mode="Ignore">
            <ui:Label text="DEAD WALLS" class="menu-title" />
        </ui:VisualElement>

        <ui:VisualElement class="menu-panel">
            <ui:VisualElement name="actions" class="menu-actions">
                <ui:VisualElement class="menu-primary-row">
                    <ui:Button name="continueButton" text="CONTINUE" class="menu-button menu-button--primary" />
                    <ui:Button name="newRunButton" text="NEW GAME" class="menu-button menu-button--primary" style="display: none;" />
                </ui:VisualElement>
                <ui:Button name="settingsButton" text="SETTINGS" class="menu-button menu-button--quiet" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="settingsOverlay" class="settings-overlay">
            <ui:VisualElement class="settings-scrim" picking-mode="Position" />
            <ui:VisualElement name="settingsModal" class="settings-modal">
                <ui:VisualElement class="settings-heading">
                    <ui:Label text="SETTINGS" class="settings-title" />
                    <ui:VisualElement class="settings-title-mark" />
                </ui:VisualElement>

                <ui:VisualElement class="settings-field">
                    <ui:VisualElement class="settings-field__heading">
                        <ui:VisualElement class="settings-field__identity"><ui:VisualElement class="menu-setting-icon menu-setting-icon--sound" picking-mode="Ignore" /><ui:Label text="SOUND EFFECTS" class="settings-field__label" /></ui:VisualElement>
                        <ui:Label name="sfxValueLabel" text="100%" class="settings-field__value" />
                    </ui:VisualElement>
                    <ui:Slider name="sfxSlider" low-value="0" high-value="1" value="1" class="dw-slider" />
                </ui:VisualElement>

                <ui:VisualElement class="settings-field">
                    <ui:VisualElement class="settings-field__heading">
                        <ui:VisualElement class="settings-field__identity"><ui:VisualElement class="menu-setting-icon menu-setting-icon--music" picking-mode="Ignore" /><ui:Label text="AMBIENCE" class="settings-field__label" /></ui:VisualElement>
                        <ui:Label name="ambienceValueLabel" text="100%" class="settings-field__value" />
                    </ui:VisualElement>
                    <ui:Slider name="ambienceSlider" low-value="0" high-value="1" value="1" class="dw-slider" />
                </ui:VisualElement>

                <ui:VisualElement class="settings-field settings-field--performance">
                    <ui:VisualElement class="settings-field__heading">
                        <ui:VisualElement class="settings-field__identity"><ui:VisualElement class="menu-setting-icon menu-setting-icon--horde" picking-mode="Ignore" /><ui:Label text="MAX ACTIVE ZOMBIES" class="settings-field__label" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-stepper">
                        <ui:Button name="zombieLimitPrevious" text="-" class="settings-stepper__button" />
                        <ui:Label name="zombieLimitValue" text="BALANCED  ·  900" class="settings-stepper__value" />
                        <ui:Button name="zombieLimitNext" text="+" class="settings-stepper__button" />
                    </ui:VisualElement>
                    <ui:Label name="zombieLimitHint" text="RECOMMENDED DEFAULT FOR PERFORMANCE AND BATTLE READABILITY." class="settings-performance-hint" />
                    <ui:Label text="LOWER LIMITS IMPROVE PERFORMANCE AND REDUCE BATTLEFIELD DENSITY. LIVING ZOMBIES ARE NEVER REMOVED." class="settings-performance-note" />
                </ui:VisualElement>

                <ui:VisualElement class="settings-separator" />
                <ui:Button name="tutorialResetButton" class="settings-text-button settings-text-button--danger settings-button-with-icon"><ui:VisualElement class="menu-setting-icon menu-setting-icon--refresh" picking-mode="Ignore" /><ui:Label name="tutorialResetButtonLabel" text="RESET TUTORIAL" class="settings-button-label" picking-mode="Ignore" /></ui:Button>
                <ui:Label name="tutorialStatusLabel" text="RESETS ONBOARDING ONLY. RUN AND UPGRADES STAY." class="settings-tutorial-status" />
                <ui:Button name="settingsCloseButton" class="settings-close settings-button-with-icon"><ui:VisualElement class="menu-setting-icon menu-setting-icon--back" picking-mode="Ignore" /><ui:Label text="BACK" class="settings-button-label" picking-mode="Ignore" /></ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
