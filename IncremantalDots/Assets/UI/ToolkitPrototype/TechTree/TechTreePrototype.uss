:root {
    --ink-950: rgb(7, 10, 13);
    --ink-900: rgb(11, 15, 19);
    --ink-850: rgb(15, 20, 24);
    --ink-800: rgb(20, 25, 29);
    --ink-700: rgb(31, 37, 41);
    --line-dark: rgba(142, 115, 65, 0.22);
    --line-mid: rgba(190, 151, 79, 0.50);
    --gold: rgb(218, 173, 84);
    --gold-bright: rgb(247, 213, 139);
    --gold-dim: rgb(130, 104, 61);
    --paper: rgb(225, 219, 202);
    --paper-dim: rgb(154, 153, 143);
    --danger: rgb(202, 82, 68);
    --success: rgb(83, 157, 116);
    --defense: rgb(116, 157, 171);
    --economy: rgb(104, 155, 123);
    --archery: rgb(166, 129, 184);
    --command: rgb(191, 132, 86);
}

.prototype-root {
    width: 100%;
    height: 100%;
    min-width: 960px;
    min-height: 540px;
    background-color: var(--ink-950);
    color: var(--paper);
    overflow: hidden;
}

.ambient {
    position: absolute;
    width: 780px;
    height: 780px;
    border-radius: 390px;
    opacity: 0.34;
    background-color: transparent;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(166, 118, 52, 0.28);
    border-right-color: rgba(166, 118, 52, 0.28);
    border-top-color: rgba(166, 118, 52, 0.28);
    border-bottom-color: rgba(166, 118, 52, 0.28);
}

.ambient--top {
    right: -310px;
    top: -480px;
}

.ambient--bottom {
    left: -380px;
    bottom: -560px;
    border-left-color: rgba(51, 113, 117, 0.24);
    border-right-color: rgba(51, 113, 117, 0.24);
    border-top-color: rgba(51, 113, 117, 0.24);
    border-bottom-color: rgba(51, 113, 117, 0.24);
}

.prototype-frame {
    position: absolute;
    left: 20px;
    right: 20px;
    top: 20px;
    bottom: 20px;
    background-color: rgba(11, 14, 17, 0.98);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(205, 161, 78, 0.52);
    border-right-color: rgba(205, 161, 78, 0.52);
    border-top-color: rgba(205, 161, 78, 0.52);
    border-bottom-color: rgba(205, 161, 78, 0.52);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    overflow: hidden;
}

.ornament {
    position: absolute;
    left: 32px;
    right: 32px;
    height: 1px;
    background-color: rgba(225, 183, 94, 0.32);
}

.ornament--top { top: 8px; }
.ornament--bottom { bottom: 8px; }

.top-bar {
    height: 92px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 32px;
    padding-right: 24px;
    background-color: rgba(16, 20, 23, 0.98);
    border-bottom-width: 1px;
    border-bottom-color: var(--line-dark);
}

.title-block {
    flex-grow: 1;
    justify-content: center;
}

.overline,
.section-label,
.filter-label,
.resource-label,
.details-eyebrow,
.map-caption-title,
.cost-label,
.footer-note {
    color: var(--gold-dim);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.title-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.screen-title {
    color: var(--gold-bright);
    font-size: 27px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.prototype-badge {
    margin-left: 14px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    color: rgb(201, 214, 210);
    background-color: rgba(58, 101, 96, 0.42);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(101, 169, 159, 0.65);
    border-right-color: rgba(101, 169, 159, 0.65);
    border-top-color: rgba(101, 169, 159, 0.65);
    border-bottom-color: rgba(101, 169, 159, 0.65);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.screen-subtitle {
    margin-top: 2px;
    color: var(--paper-dim);
    font-size: 12px;
}

.run-status {
    flex-direction: row;
    align-items: center;
}

.resource-chip {
    min-width: 88px;
    height: 48px;
    margin-left: 8px;
    padding-left: 12px;
    padding-right: 12px;
    justify-content: center;
    background-color: rgba(25, 29, 32, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(132, 109, 67, 0.36);
    border-right-color: rgba(132, 109, 67, 0.36);
    border-top-color: rgba(132, 109, 67, 0.36);
    border-bottom-color: rgba(132, 109, 67, 0.36);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.resource-chip--knowledge {
    background-color: rgba(62, 45, 24, 0.76);
    border-left-color: rgba(217, 173, 85, 0.56);
    border-right-color: rgba(217, 173, 85, 0.56);
    border-top-color: rgba(217, 173, 85, 0.56);
    border-bottom-color: rgba(217, 173, 85, 0.56);
}

.resource-value {
    color: var(--paper);
    font-size: 16px;
    -unity-font-style: bold;
}

.resource-value--gold { color: var(--gold-bright); }

.close-button {
    width: 74px;
    height: 48px;
    margin-left: 12px;
    color: var(--paper-dim);
    background-color: rgba(34, 29, 27, 0.90);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(153, 97, 76, 0.55);
    border-right-color: rgba(153, 97, 76, 0.55);
    border-top-color: rgba(153, 97, 76, 0.55);
    border-bottom-color: rgba(153, 97, 76, 0.55);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.12s;
}

.close-button:hover {
    color: rgb(246, 218, 202);
    background-color: rgba(95, 47, 38, 0.76);
    border-left-color: rgb(193, 101, 81);
    border-right-color: rgb(193, 101, 81);
    border-top-color: rgb(193, 101, 81);
    border-bottom-color: rgb(193, 101, 81);
}

.command-bar {
    height: 50px;
    padding-left: 24px;
    padding-right: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(9, 12, 15, 0.96);
    border-bottom-width: 1px;
    border-bottom-color: rgba(143, 116, 67, 0.24);
}

.filter-strip,
.siege-status,
.hint-group,
.requirement-row,
.cost-row,
.impact-row,
.details-header {
    flex-direction: row;
    align-items: center;
}

.filter-label { margin-right: 10px; }

.filter-button {
    height: 28px;
    margin-right: 5px;
    padding-left: 12px;
    padding-right: 12px;
    color: rgb(131, 133, 129);
    background-color: rgba(24, 28, 31, 0.65);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: transparent;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    transition-property: color, background-color, border-color;
    transition-duration: 0.15s;
}

.filter-button:hover {
    color: var(--paper);
    background-color: rgba(48, 48, 42, 0.70);
}

.filter-button--active {
    color: var(--gold-bright);
    background-color: rgba(82, 61, 30, 0.55);
    border-bottom-color: var(--gold);
}

.siege-status {
    height: 30px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgba(50, 24, 23, 0.52);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(160, 66, 55, 0.42);
    border-right-color: rgba(160, 66, 55, 0.42);
    border-top-color: rgba(160, 66, 55, 0.42);
    border-bottom-color: rgba(160, 66, 55, 0.42);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.siege-pulse {
    width: 7px;
    height: 7px;
    margin-right: 8px;
    border-radius: 4px;
    background-color: var(--danger);
    opacity: 1;
    scale: 1 1;
    transition-property: opacity, scale;
    transition-duration: 0.55s;
}

.siege-pulse--dim {
    opacity: 0.36;
    scale: 0.72 0.72;
}

.siege-title {
    color: rgb(223, 141, 126);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.siege-divider {
    width: 1px;
    height: 12px;
    margin-left: 10px;
    margin-right: 10px;
    background-color: rgba(166, 106, 87, 0.36);
}

.siege-value {
    color: rgb(191, 184, 169);
    font-size: 9px;
    -unity-font-style: bold;
}

.siege-value--warning { color: rgb(235, 173, 117); }

.main-body {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    padding: 14px;
    background-color: var(--ink-950);
}

.map-viewport {
    flex-grow: 1;
    min-width: 0;
    position: relative;
    overflow: hidden;
    background-color: rgb(10, 14, 17);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(158, 126, 69, 0.30);
    border-right-color: rgba(158, 126, 69, 0.30);
    border-top-color: rgba(158, 126, 69, 0.30);
    border-bottom-color: rgba(158, 126, 69, 0.30);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.map-viewport:focus {
    border-left-color: rgba(216, 172, 82, 0.56);
    border-right-color: rgba(216, 172, 82, 0.56);
    border-top-color: rgba(216, 172, 82, 0.56);
    border-bottom-color: rgba(216, 172, 82, 0.56);
}

.map-grid {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0.25;
}

.map-grid--large {
    background-color: rgba(33, 40, 43, 0.20);
    border-left-width: 1px;
    border-top-width: 1px;
    border-left-color: rgba(116, 97, 63, 0.12);
    border-top-color: rgba(116, 97, 63, 0.12);
}

.map-grid--fine {
    left: 18px;
    right: 18px;
    top: 18px;
    bottom: 18px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(188, 150, 81, 0.08);
    border-right-color: rgba(188, 150, 81, 0.08);
    border-top-color: rgba(188, 150, 81, 0.08);
    border-bottom-color: rgba(188, 150, 81, 0.08);
}

.map-vignette {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-left-width: 22px;
    border-right-width: 22px;
    border-top-width: 22px;
    border-bottom-width: 22px;
    border-left-color: rgba(4, 6, 8, 0.34);
    border-right-color: rgba(4, 6, 8, 0.34);
    border-top-color: rgba(4, 6, 8, 0.34);
    border-bottom-color: rgba(4, 6, 8, 0.34);
}

.graph-content {
    position: absolute;
    width: 1300px;
    height: 760px;
    left: 8px;
    top: 4px;
    transform-origin: 0 0;
}

.edge-layer,
.node-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 1300px;
    height: 760px;
}

.doctrine-lane {
    position: absolute;
    left: 300px;
    width: 930px;
    height: 148px;
    background-color: rgba(25, 30, 31, 0.20);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(116, 111, 92, 0.08);
    border-bottom-color: rgba(116, 111, 92, 0.08);
}

.doctrine-lane--economy {
    background-color: rgba(40, 77, 55, 0.08);
    border-top-color: rgba(104, 155, 123, 0.10);
    border-bottom-color: rgba(104, 155, 123, 0.10);
}

.doctrine-lane--defense {
    background-color: rgba(43, 74, 84, 0.08);
    border-top-color: rgba(116, 157, 171, 0.10);
    border-bottom-color: rgba(116, 157, 171, 0.10);
}

.doctrine-lane--archery {
    background-color: rgba(77, 52, 88, 0.08);
    border-top-color: rgba(166, 129, 184, 0.10);
    border-bottom-color: rgba(166, 129, 184, 0.10);
}

.doctrine-lane--command {
    background-color: rgba(91, 58, 39, 0.08);
    border-top-color: rgba(191, 132, 86, 0.10);
    border-bottom-color: rgba(191, 132, 86, 0.10);
}

.tier-marker {
    position: absolute;
    top: 17px;
    height: 22px;
    color: rgba(174, 144, 88, 0.68);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    -unity-text-align: middle-center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(159, 127, 70, 0.18);
}

.edge {
    position: absolute;
    min-width: 2px;
    min-height: 2px;
    background-color: rgb(72, 70, 61);
    opacity: 0.72;
    transition-property: background-color, opacity;
    transition-duration: 0.25s;
}

.edge--owned {
    background-color: rgba(196, 155, 77, 0.82);
    opacity: 1;
}

.edge--available {
    background-color: rgba(151, 121, 66, 0.78);
    opacity: 0.90;
}

.edge--locked {
    background-color: rgba(66, 70, 68, 0.66);
    opacity: 0.46;
}

.edge-joint {
    position: absolute;
    width: 7px;
    height: 7px;
    margin-left: -3px;
    margin-top: -3px;
    border-radius: 4px;
    background-color: rgb(94, 87, 70);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(216, 172, 82, 0.38);
    border-right-color: rgba(216, 172, 82, 0.38);
    border-top-color: rgba(216, 172, 82, 0.38);
    border-bottom-color: rgba(216, 172, 82, 0.38);
}

.node-card {
    position: absolute;
    width: 232px;
    height: 108px;
    padding: 0;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    color: var(--paper);
    background-color: rgba(18, 23, 25, 0.99);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(133, 110, 67, 0.62);
    border-right-color: rgba(133, 110, 67, 0.62);
    border-top-color: rgba(133, 110, 67, 0.62);
    border-bottom-color: rgba(133, 110, 67, 0.62);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
    transition-property: opacity, translate, scale, border-color, background-color;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.node-card:hover {
    translate: 0 -3px;
    scale: 1.015 1.015;
    background-color: rgba(34, 34, 29, 0.98);
    border-left-color: rgba(228, 184, 96, 0.92);
    border-right-color: rgba(228, 184, 96, 0.92);
    border-top-color: rgba(228, 184, 96, 0.92);
    border-bottom-color: rgba(228, 184, 96, 0.92);
}

.node-card:active {
    translate: 0 0;
    scale: 0.985 0.985;
}

.node-card:focus {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--gold-bright);
    border-right-color: var(--gold-bright);
    border-top-color: var(--gold-bright);
    border-bottom-color: var(--gold-bright);
}

.node-card--enter {
    opacity: 0;
    translate: -16px 0;
}

.node-card--owned {
    border-left-color: rgba(117, 167, 124, 0.78);
    border-right-color: rgba(117, 167, 124, 0.78);
    border-top-color: rgba(117, 167, 124, 0.78);
    border-bottom-color: rgba(117, 167, 124, 0.78);
}

.node-card--available {
    border-left-color: rgba(206, 160, 74, 0.82);
    border-right-color: rgba(206, 160, 74, 0.82);
    border-top-color: rgba(206, 160, 74, 0.82);
    border-bottom-color: rgba(206, 160, 74, 0.82);
}

.node-card--locked {
    opacity: 0.60;
    background-color: rgba(15, 18, 19, 0.96);
    border-left-color: rgba(83, 87, 83, 0.52);
    border-right-color: rgba(83, 87, 83, 0.52);
    border-top-color: rgba(83, 87, 83, 0.52);
    border-bottom-color: rgba(83, 87, 83, 0.52);
}

.node-card--selected {
    opacity: 1;
    translate: 0 -3px;
    scale: 1.035 1.035;
    background-color: rgba(49, 39, 24, 0.98);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--gold-bright);
    border-right-color: var(--gold-bright);
    border-top-color: var(--gold-bright);
    border-bottom-color: var(--gold-bright);
}

.node-card--preview {
    background-color: rgba(88, 63, 28, 1);
    border-left-color: rgb(255, 227, 161);
    border-right-color: rgb(255, 227, 161);
    border-top-color: rgb(255, 227, 161);
    border-bottom-color: rgb(255, 227, 161);
    scale: 1.07 1.07;
}

.node-card--ambient {
    border-left-color: rgba(245, 205, 119, 0.92);
    border-right-color: rgba(245, 205, 119, 0.92);
    border-top-color: rgba(245, 205, 119, 0.92);
    border-bottom-color: rgba(245, 205, 119, 0.92);
}

.node-card--filtered {
    opacity: 0.16;
    scale: 0.96 0.96;
}

.node-accent {
    position: absolute;
    left: 0;
    top: 13px;
    bottom: 13px;
    width: 3px;
    background-color: var(--gold-dim);
    opacity: 0.76;
    transition-property: width, opacity, background-color;
    transition-duration: 0.18s;
}

.node-card:hover .node-accent,
.node-card--selected .node-accent {
    width: 5px;
    opacity: 1;
}

.node-corner {
    position: absolute;
    right: 7px;
    top: 7px;
    width: 11px;
    height: 11px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-right-color: rgba(206, 166, 86, 0.46);
    border-top-color: rgba(206, 166, 86, 0.46);
}

.branch-accent--root { background-color: var(--gold); }
.branch-accent--defense { background-color: var(--defense); }
.branch-accent--economy { background-color: var(--economy); }
.branch-accent--archery { background-color: var(--archery); }
.branch-accent--command { background-color: var(--command); }

.node-top {
    height: 72px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 8px;
}

.node-sigil,
.detail-sigil {
    flex-shrink: 0;
    background-color: rgba(21, 25, 26, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(189, 151, 79, 0.52);
    border-right-color: rgba(189, 151, 79, 0.52);
    border-top-color: rgba(189, 151, 79, 0.52);
    border-bottom-color: rgba(189, 151, 79, 0.52);
    align-items: center;
    justify-content: center;
}

.node-sigil {
    width: 48px;
    height: 48px;
    margin-right: 9px;
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
}

.detail-sigil {
    width: 72px;
    height: 72px;
    margin-right: 14px;
    border-top-left-radius: 36px;
    border-top-right-radius: 36px;
    border-bottom-left-radius: 36px;
    border-bottom-right-radius: 36px;
}

.branch--root {
    background-color: rgba(83, 61, 27, 0.92);
}

.branch--defense {
    background-color: rgba(28, 48, 55, 0.94);
    border-left-color: var(--defense);
    border-right-color: var(--defense);
    border-top-color: var(--defense);
    border-bottom-color: var(--defense);
}

.branch--economy {
    background-color: rgba(28, 51, 39, 0.94);
    border-left-color: var(--economy);
    border-right-color: var(--economy);
    border-top-color: var(--economy);
    border-bottom-color: var(--economy);
}

.branch--archery {
    background-color: rgba(48, 34, 57, 0.94);
    border-left-color: var(--archery);
    border-right-color: var(--archery);
    border-top-color: var(--archery);
    border-bottom-color: var(--archery);
}

.branch--command {
    background-color: rgba(61, 39, 28, 0.94);
    border-left-color: var(--command);
    border-right-color: var(--command);
    border-top-color: var(--command);
    border-bottom-color: var(--command);
}

.node-sigil-letter,
.detail-sigil-letter {
    color: var(--paper);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.node-sigil-letter {
    font-size: 15px;
}

.detail-sigil-letter {
    font-size: 24px;
}

.node-copy {
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
}

.node-kicker {
    color: var(--gold-dim);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.node-title {
    margin-top: 2px;
    color: var(--paper);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
}

.node-state {
    margin-top: 3px;
    color: rgb(135, 138, 133);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 0.7px;
}

.node-card--owned .node-state { color: rgb(114, 185, 137); }
.node-card--available .node-state { color: rgb(229, 184, 96); }
.node-card--locked .node-state { color: rgb(112, 116, 113); }

.node-bottom {
    height: 31px;
    margin-left: 9px;
    margin-right: 9px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-top-width: 1px;
    border-top-color: rgba(151, 126, 78, 0.20);
}

.node-effect {
    color: rgb(169, 166, 151);
    font-size: 9px;
}

.node-cost {
    color: var(--gold-bright);
    font-size: 9px;
    -unity-font-style: bold;
}

.map-caption {
    position: absolute;
    left: 15px;
    bottom: 14px;
    padding: 8px 10px;
    background-color: rgba(7, 10, 12, 0.80);
    border-left-width: 2px;
    border-left-color: rgba(192, 151, 77, 0.55);
}

.map-caption-value {
    margin-top: 2px;
    color: rgb(143, 145, 137);
    font-size: 9px;
}

.zoom-controls {
    position: absolute;
    right: 14px;
    bottom: 14px;
    height: 32px;
    flex-direction: row;
    background-color: rgba(7, 10, 12, 0.86);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(151, 126, 78, 0.36);
    border-right-color: rgba(151, 126, 78, 0.36);
    border-top-color: rgba(151, 126, 78, 0.36);
    border-bottom-color: rgba(151, 126, 78, 0.36);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.zoom-button,
.zoom-reset {
    height: 30px;
    color: rgb(192, 188, 174);
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    -unity-font-style: bold;
}

.zoom-button {
    width: 32px;
    font-size: 16px;
}

.zoom-reset {
    width: 54px;
    font-size: 9px;
}

.zoom-button:hover,
.zoom-reset:hover {
    color: var(--gold-bright);
    background-color: rgba(90, 67, 33, 0.55);
}

.details-panel {
    width: 374px;
    min-width: 374px;
    margin-left: 12px;
    padding: 20px;
    background-color: rgba(20, 18, 15, 0.99);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(193, 151, 75, 0.48);
    border-right-color: rgba(193, 151, 75, 0.48);
    border-top-color: rgba(193, 151, 75, 0.48);
    border-bottom-color: rgba(193, 151, 75, 0.48);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    translate: 0 0;
    opacity: 1;
    transition-property: translate, opacity, border-color;
    transition-duration: 0.20s;
}

.details-panel--refresh {
    translate: 9px 0;
    opacity: 0.68;
    border-left-color: var(--gold-bright);
    border-right-color: var(--gold-bright);
    border-top-color: var(--gold-bright);
    border-bottom-color: var(--gold-bright);
}

.details-accent {
    position: absolute;
    left: 8px;
    top: 18px;
    bottom: 18px;
    width: 2px;
    background-color: rgba(207, 164, 81, 0.46);
}

.details-heading-copy {
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
}

.details-eyebrow { color: var(--gold); }

.details-title {
    margin-top: 4px;
    color: var(--gold-bright);
    font-size: 21px;
    -unity-font-style: bold;
    white-space: normal;
}

.details-tier {
    margin-top: 3px;
    color: rgb(137, 138, 131);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.rule {
    height: 1px;
    margin-top: 16px;
    margin-bottom: 16px;
    background-color: rgba(140, 112, 64, 0.28);
}

.rule--bright {
    background-color: rgba(201, 158, 79, 0.42);
}

.details-quote {
    color: rgb(218, 194, 148);
    font-size: 13px;
    -unity-font-style: italic;
    white-space: normal;
    margin-bottom: 10px;
}

.details-description {
    color: rgb(174, 171, 159);
    font-size: 11px;
    white-space: normal;
}

.impact-card {
    margin-top: 18px;
    padding: 12px;
    background-color: rgba(8, 11, 13, 0.72);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(133, 108, 64, 0.30);
    border-right-color: rgba(133, 108, 64, 0.30);
    border-top-color: rgba(133, 108, 64, 0.30);
    border-bottom-color: rgba(133, 108, 64, 0.30);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.impact-row {
    height: 27px;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: rgba(114, 99, 69, 0.18);
}

.impact-row--last { border-bottom-width: 0; }

.impact-name {
    color: rgb(154, 155, 148);
    font-size: 10px;
}

.impact-value {
    color: rgb(120, 190, 143);
    font-size: 11px;
    -unity-font-style: bold;
}

.impact-value--muted { color: rgb(189, 159, 109); }

.requirement-block { margin-top: 16px; }

.requirement-row {
    margin-top: 7px;
    height: 32px;
    padding-left: 9px;
    padding-right: 9px;
    background-color: rgba(14, 18, 19, 0.66);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(93, 113, 100, 0.35);
    border-right-color: rgba(93, 113, 100, 0.35);
    border-top-color: rgba(93, 113, 100, 0.35);
    border-bottom-color: rgba(93, 113, 100, 0.35);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.requirement-mark {
    width: 8px;
    height: 8px;
    margin-right: 9px;
    border-radius: 4px;
    background-color: rgb(101, 105, 102);
}

.requirement-mark--met { background-color: var(--success); }
.requirement-mark--blocked { background-color: var(--danger); }

.requirement-text {
    color: rgb(176, 178, 169);
    font-size: 10px;
}

.details-spacer { flex-grow: 1; min-height: 8px; }

.cost-row {
    height: 38px;
    justify-content: space-between;
    border-top-width: 1px;
    border-top-color: rgba(165, 132, 72, 0.30);
}

.cost-value {
    color: var(--gold-bright);
    font-size: 22px;
    -unity-font-style: bold;
}

.preview-button {
    height: 46px;
    color: rgb(33, 25, 13);
    background-color: rgb(204, 156, 69);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(244, 210, 139);
    border-right-color: rgb(244, 210, 139);
    border-top-color: rgb(244, 210, 139);
    border-bottom-color: rgb(244, 210, 139);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    scale: 1 1;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.12s;
}

.preview-button:hover {
    background-color: rgb(229, 185, 97);
    border-left-color: rgb(255, 229, 171);
    border-right-color: rgb(255, 229, 171);
    border-top-color: rgb(255, 229, 171);
    border-bottom-color: rgb(255, 229, 171);
    scale: 1.012 1.012;
}

.preview-button:active { scale: 0.98 0.98; }

.preview-button:disabled {
    color: rgb(107, 105, 98);
    background-color: rgb(43, 43, 40);
    border-left-color: rgb(72, 71, 67);
    border-right-color: rgb(72, 71, 67);
    border-top-color: rgb(72, 71, 67);
    border-bottom-color: rgb(72, 71, 67);
}

.preview-disclaimer {
    margin-top: 6px;
    color: rgb(104, 105, 100);
    font-size: 8px;
    -unity-text-align: middle-center;
}

.footer-bar {
    height: 44px;
    padding-left: 24px;
    padding-right: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(13, 16, 19, 0.98);
    border-top-width: 1px;
    border-top-color: rgba(148, 117, 65, 0.24);
}

.input-key {
    height: 22px;
    min-width: 40px;
    padding-left: 7px;
    padding-right: 7px;
    margin-right: 5px;
    color: rgb(205, 198, 179);
    background-color: rgba(49, 49, 44, 0.72);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(147, 124, 80, 0.42);
    border-right-color: rgba(147, 124, 80, 0.42);
    border-top-color: rgba(147, 124, 80, 0.42);
    border-bottom-color: rgba(147, 124, 80, 0.42);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.input-label {
    margin-right: 14px;
    color: rgb(116, 119, 115);
    font-size: 8px;
    -unity-font-style: bold;
}

.footer-note {
    color: rgb(93, 96, 93);
    font-size: 8px;
}

.prototype-toast {
    position: absolute;
    right: 42px;
    bottom: 78px;
    width: 336px;
    min-height: 66px;
    padding: 12px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(18, 23, 23, 0.98);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(211, 168, 81, 0.70);
    border-right-color: rgba(211, 168, 81, 0.70);
    border-top-color: rgba(211, 168, 81, 0.70);
    border-bottom-color: rgba(211, 168, 81, 0.70);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    opacity: 0;
    translate: 24px 0;
    transition-property: opacity, translate;
    transition-duration: 0.22s;
}

.prototype-toast--visible {
    opacity: 1;
    translate: 0 0;
}

.toast-mark {
    width: 10px;
    height: 38px;
    margin-right: 12px;
    background-color: var(--gold);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

.toast-copy { flex-grow: 1; }

.toast-title {
    color: var(--gold-bright);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.toast-message {
    margin-top: 4px;
    color: rgb(157, 158, 151);
    font-size: 9px;
}
