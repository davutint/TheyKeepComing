  m_Script: {fileID: 11500000, guid: 28bd919e7eea8be478f6ff9a9ae93566, type: 3}
  m_Name: Template_merchant_caravan
  m_EditorClassIdentifier: DeadWalls::DeadWalls.CouncilTemplateSO
  Id: merchant_caravan
  Title: MERCHANT CARAVAN
  Body: "A caravan master offers goods from the far settlements \u2014 for a price."
  BodyVariants:
  - "A dust-caked caravan halts at the gate. The master looks over our stockpiles
    with a practiced eye. 'You're sitting on {PAY_RES} and starving for {GAIN_RES}.
    I can fix that \u2014 for a price.'"
  - "Traders out of the burned valley. Their wagons carry good {GAIN_RES} \u2014
    and they know exactly how badly we need it."
  OutcomeA: Hands are shaken. Their crew unloads {GAIN_N} {GAIN_RES} while ours counts
    out {PAY_N} {PAY_RES}. The caravan is over the ridge before dusk.
  OutcomeB: We decline the full trade. The master leaves {GAIN_N} {GAIN_RES} as a
    sample of what his next caravan could bring.
  Contrast: 1
  OptionAAtomIds:
  - pay_resource
  OptionBAtomIds:
  - gain_resource
  OptionAVerb: Make the trade
  OptionBVerb: Take the sample
  BaseWeight: 1
  MinDay: 1
  RequiredFlags: []
  ForbiddenFlags:
  - traded_with_merchant
  SetsFlagOnA: traded_with_merchant
  SetsFlagOnB: 
  ChainDelayDays: 0
  OneShot: 0
